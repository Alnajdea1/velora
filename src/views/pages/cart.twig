{% extends 'layouts.master' %}
{% block title %}{{ trans('cart.title') }}{% endblock %}
{% block content %}
  <section class="v-page-hero v-page-hero--cart v-curve-bottom">
    <div class="v-wrap"><salla-breadcrumb></salla-breadcrumb><h1>{{ trans('cart.title') }}</h1><p>{{ trans('cart.subtitle') }}</p></div>
  </section>
  <section class="v-section v-cart-page">
    <div class="v-wrap">
      {% hook 'cart:start' %}
      {% if cart.items|length %}
        <div class="v-cart-layout">
          <div class="v-cart-items">
            {% hook 'cart:items.start' %}
            {% for item in cart.items %}
              <form class="v-cart-item" data-cart-item="{{ item.id }}" onchange="salla.form.onChange('cart.updateItem', event)">
                <input type="hidden" name="id" value="{{ item.id }}">
                <a href="{{ item.url }}" class="v-cart-item__image"><img src="{{ item.product_image }}" alt="{{ item.product_name }}"></a>
                <div class="v-cart-item__body">
                  <a href="{{ item.url }}"><h2>{{ item.product_name }}</h2></a>
                  {% for option in item.options %}<small>{{ option.name }}: {{ option.value }}</small>{% endfor %}
                  <strong>{{ item.total|money }}</strong>
                  <div class="v-cart-item__actions">
                    {% if item.is_hidden_quantity or item.type == 'donating' %}<input type="hidden" name="quantity" value="{{ item.quantity }}"><span>{{ item.quantity }}</span>{% else %}<salla-quantity-input cart-item-id="{{ item.id }}" name="quantity" value="{{ item.quantity }}" max="{{ item.max_quantity }}"></salla-quantity-input>{% endif %}
                    <button type="button" class="v-link-danger" data-remove-cart="{{ item.id }}">{{ trans('cart.remove') }}</button>
                  </div>
                </div>
              </form>
            {% endfor %}
            {% hook 'cart:items.end' %}
            {% if store.settings.cart.add_notes_enabled %}
              <label class="v-card v-cart-note"><span>{{ trans('cart.note') }}</span><textarea class="v-field" name="notes" placeholder="{{ trans('cart.note_placeholder') }}">{{ cart.notes }}</textarea></label>
            {% endif %}
          </div>

          <aside class="v-cart-summary">{% hook 'cart:summary.start' %}
            <h2>{{ trans('cart.summary') }}</h2>
            {% if cart.free_shipping_bar %}<div class="v-shipping-progress"><p>{{ cart.free_shipping_bar.has_free_shipping ? trans('cart.free_shipping_unlocked') : trans('cart.free_shipping_remaining', {amount:cart.free_shipping_bar.remaining|money}) }}</p><span><i style="width:{{ cart.free_shipping_bar.percent }}%"></i></span></div>{% endif %}
            {% if store.settings.cart.apply_coupon_enabled %}{% hook 'cart:coupon.start' %}<salla-cart-coupons></salla-cart-coupons>{% hook 'cart:coupon.end' %}{% endif %}
            {% hook 'cart:summary-card.start' %}<salla-cart-summary-card></salla-cart-summary-card>{% hook 'cart:summary-card.end' %}
            <p class="v-cart-secure">🔒 {{ trans('cart.checkout_note') }}</p>
            {% hook 'cart:summary.end' %}</aside>
        </div>
      {% else %}
        <div class="v-empty v-empty--large v-cart-empty"><span class="v-petal v-empty__petal"></span><h2>{{ trans('cart.empty_title') }}</h2><p>{{ trans('cart.empty_body') }}</p><a href="{{ link('products') }}" class="v-btn v-btn--primary">{{ trans('common.discover') }}</a></div>
      {% endif %}
      {% hook 'cart:end' %}
    </div>
  </section>
{% endblock %}
