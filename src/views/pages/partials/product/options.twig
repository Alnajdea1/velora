{% if product.options|length %}
  <salla-product-options data-testid="store-product-options" options="{{ product.options }}" product-id="{{ product.id }}"></salla-product-options>
{% elseif product.has_options %}
  <salla-product-options data-testid="store-product-options" product-id="{{ product.id }}"></salla-product-options>
{% endif %}

{% if product.has_bundle_products %}
  <salla-multiple-bundle-product bundle-sections="{{ product|json_encode }}"></salla-multiple-bundle-product>
{% endif %}
