{% extends 'layouts.master' %}
{% block title %}{{ brand.name }}{% endblock %}
{% block content %}
  <section class="v-page-hero v-curve-bottom"><div class="v-wrap v-brand-intro">{% if brand.logo %}<img src="{{ brand.logo }}" alt="{{ brand.name }}">{% endif %}<div><salla-breadcrumb></salla-breadcrumb><h1>{{ brand.name }}</h1><p>{{ brand.description }}</p></div></div></section>
  <section class="v-section"><div class="v-wrap">{% if products|length %}<div class="v-grid v-grid--4">{% for product in products %}{% include 'components.product-card' with {product:product} %}{% endfor %}</div>{% else %}<div class="v-empty"><h2>{{ trans('collection.empty_title') }}</h2></div>{% endif %}<salla-pagination></salla-pagination></div></section>
{% endblock %}
