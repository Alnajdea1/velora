{% extends 'layouts.master' %}
{% block title %}{{ page.title }}{% endblock %}
{% block content %}
  <section class="v-page-hero v-curve-bottom"><div class="v-wrap"><salla-breadcrumb></salla-breadcrumb><h1>{{ page.title }}</h1></div></section>
  <section class="v-section"><div class="v-wrap v-brand-grid">{% for brand in brands %}<a href="{{ brand.url }}" class="v-brand-card"><div>{% if brand.logo %}<img src="{{ brand.logo }}" alt="{{ brand.name }}" loading="lazy">{% else %}<span class="v-petal"></span>{% endif %}</div><h2>{{ brand.name }}</h2></a>{% endfor %}</div><salla-pagination></salla-pagination></section>
{% endblock %}

