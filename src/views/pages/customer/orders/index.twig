{% extends 'layouts.master' %}
{% block title %}{{ trans('account.orders') }}{% endblock %}
{% block content %}
  <section class="v-page-hero v-curve-bottom"><div class="v-wrap"><salla-breadcrumb></salla-breadcrumb><h1>{{ trans('account.orders') }}</h1></div></section>
  <section class="v-section"><div class="v-wrap v-account-layout">
    <aside class="v-account-nav"><salla-user-menu></salla-user-menu></aside>
    <div class="v-order-list">{% hook 'customer:orders.index.items.start' %}
      {% for order in orders %}
        <article class="v-order-card"><div><small>#{{ order.reference_id|default(order.id) }}</small><h2>{{ order.created_at|date('Y-m-d') }}</h2></div><span class="v-badge">{{ order.status.name }}</span><strong>{{ order.total|money }}</strong><a href="{{ order.url }}" class="v-btn v-btn--ghost">{{ trans('account.details') }}</a></article>
      {% else %}<div class="v-empty"><h2>{{ trans('account.orders_empty') }}</h2></div>{% endfor %}
      {% hook 'customer:orders.index.items.end' %}
      <salla-pagination></salla-pagination>
    </div>
  </div></section>
{% endblock %}

