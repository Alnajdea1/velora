{% extends 'layouts.master' %}
{% block title %}{{ trans('account.orders') }}{% endblock %}
{% block content %}
  <section class="v-page-hero v-curve-bottom"><div class="v-wrap"><salla-breadcrumb></salla-breadcrumb><h1>{{ trans('account.orders') }}</h1></div></section>
  <section class="v-section"><div class="v-wrap v-account-layout">
    <aside class="v-account-nav"><salla-user-menu></salla-user-menu></aside>
    <div class="v-order-list">{% hook 'customer:orders.index.items.start' %}
      {% if orders|length %}
        <salla-orders data-testid="store-orders-list"></salla-orders>
      {% else %}
        <div class="v-empty"><h2>{{ trans('account.orders_empty') }}</h2></div>
      {% endif %}
      {% hook 'customer:orders.index.items.end' %}
    </div>
  </div></section>
{% endblock %}
