{% extends 'layouts.master' %}
{% block title %}{{ page.title|striptags }}{% endblock %}
{% block content %}
  <section class="v-curve-bottom" style="padding:46px 0 90px;background:linear-gradient(170deg,var(--mist),var(--porcelain))">
    <div class="v-wrap">
      <salla-breadcrumb></salla-breadcrumb>
      <h1 style="margin-top:16px;font-size:clamp(34px,3.6vw,52px)">{{ page.title|raw }}</h1>
      <p style="margin-top:12px;max-width:620px;font-size:14px;line-height:1.85;color:var(--leaf)">{{ page.description }}</p>
    </div>
  </section>

  {% hook 'product.index.before_products_group_with_filter' %}
  <section style="padding:40px 0 90px">
    <div class="v-wrap v-collection {{ filters ? 'has-filters' : '' }}" data-collection>
      {% if filters %}<aside class="v-filters" style="position:sticky;top:100px;padding:26px;border-radius:32px;background:var(--porcelain);box-shadow:inset 0 0 0 1px var(--mist)">
        <salla-filters></salla-filters>
      </aside>{% endif %}

      <div>
        <div class="v-card" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding:14px 18px;border-radius:24px;box-shadow:inset 0 0 0 1px var(--mist)">
          <span style="font-size:13px;color:var(--leaf)">{{ trans('collection.count', { n: products|length }) }}</span>
          <span style="flex:1"></span>
          {% if filters %}<button type="button" class="v-btn v-btn--ghost v-filters-toggle" data-open="filters">{{ trans('collection.filters') }}</button>{% endif %}
          {% if sort_options|length %}<select id="product-filter" class="v-field" style="width:auto" aria-label="{{ trans('collection.sort') }}">{% for sort in sort_options %}<option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>{% endfor %}</select>{% endif %}
          <div class="v-pill v-view-toggle" style="display:flex;gap:4px;padding:3px;background:var(--mist)">
            <button type="button" class="v-chip v-pill" data-view="grid" aria-pressed="true">{{ trans('collection.grid') }}</button>
            <button type="button" class="v-chip v-pill" data-view="list" aria-pressed="false">{{ trans('collection.list') }}</button>
          </div>
        </div>

        <div data-active-filters style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px"></div>

        {% hook 'product:index.items.start' %}
        {% if products|length %}
          <div class="v-grid v-grid--3" data-products style="margin-top:24px">
            {% for product in products %}{% include 'components.product-card' with { product: product } %}{% endfor %}
          </div>
          <salla-pagination style="display:flex;justify-content:center;gap:8px;margin-top:40px"></salla-pagination>
        {% else %}
          <div class="v-empty" style="margin-top:24px">
            <span class="v-petal" style="display:block;width:86px;height:86px;margin-inline:auto;background:linear-gradient(150deg,var(--lilac),var(--iris));animation:v-sway 9s ease-in-out infinite"></span>
            <h3 style="margin-top:20px;font-size:24px">{{ trans('collection.empty_title') }}</h3>
            <p style="margin-top:10px;max-width:340px;margin-inline:auto;font-size:13.5px;line-height:1.8;color:var(--leaf)">{{ trans('collection.empty_body') }}</p>
            <a href="{{ link('products') }}" class="v-btn v-btn--dark v-pill" style="margin-top:20px">{{ trans('collection.clear') }}</a>
          </div>
        {% endif %}
        {% hook 'product:index.items.end' %}

        <template data-skeleton>
          <div class="v-card" style="padding:14px">
            <div class="v-skeleton" style="aspect-ratio:4/5"></div>
            <div class="v-skeleton" style="height:14px;width:62%;margin-top:16px;border-radius:999px"></div>
            <div class="v-skeleton" style="height:12px;width:38%;margin-top:9px;border-radius:999px"></div>
          </div>
        </template>
      </div>
    </div>
  </section>
  {% hook 'product.index.after_products_group_with_filter' %}

  {% if filters %}{% include 'components.filters-sheet' %}{% endif %}
  {% hook 'product.index.after_testimonials' %}
{% endblock %}
