<footer class="v-dark" style="padding:clamp(46px,7vw,70px) 0 40px">
  <div class="v-wrap v-grid v-grid--4">
    <div>
      <div style="display:flex;align-items:center;gap:10px">
        <span class="v-petal" style="width:30px;height:30px;background:linear-gradient(150deg,var(--lilac),var(--iris))"></span>
        <span style="font-family:var(--display);font-size:20px">{{ store.name }}</span>
      </div>
      <p style="margin-top:14px;font-size:13px;line-height:1.9;color:rgba(241,236,255,.6);max-width:260px">{{ store.description }}</p>
    </div>
    {% for menu in menus.footer %}
      <div>
        <div style="font-size:12px;font-weight:800;color:var(--lilac)">{{ menu.title }}</div>
        <div style="display:flex;flex-direction:column;gap:11px;margin-top:16px">
          {% for item in menu.items %}<a href="{{ item.url }}" style="font-size:13px;color:rgba(241,236,255,.6)">{{ item.title }}</a>{% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="v-wrap" style="margin-top:40px;padding-top:22px;border-top:1px solid rgba(252,251,255,.1);display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;font-size:12px;color:rgba(241,236,255,.6)">
    <span>© {{ "now"|date("Y") }} {{ store.name }}</span>
    <span style="font-family:var(--latin);letter-spacing:.1em">LAVENDER, REIMAGINED</span>
  </div>
</footer>
