{# velora.editorial_story #}
<section class="v-section" data-component="editorial-story" style="background:var(--mist)">
  <div class="v-wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));align-items:center">
    <div class="v-story__art" style="position:relative;min-height:clamp(300px,40vw,520px);border-radius:220px 40px 40px 220px;overflow:hidden;background:linear-gradient(200deg,var(--sage),var(--leaf) 60%,var(--aubergine))">
      {% if component.image %}<img src="{{ component.image }}" alt="{{ component.image_alt }}" style="width:100%;height:100%;object-fit:cover">{% else %}<i aria-hidden="true"></i><b class="v-petal" aria-hidden="true"></b>{% endif %}
    </div>
    <div class="v-editorial" style="position:relative;z-index:2;margin-inline-start:-70px;padding:40px;background:var(--porcelain);box-shadow:0 50px 80px -60px rgba(38,24,56,.55)">
      <span style="font-family:var(--latin);font-size:11px;font-weight:700;letter-spacing:.22em;color:var(--leaf)">{{ component.kicker ?: trans('story.kicker') }}</span>
      <h2 style="margin-top:16px;font-size:clamp(34px,3.6vw,52px)">{{ component.title ?: trans('story.title') }}</h2>
      <p style="margin-top:18px;font-size:15px;line-height:1.9;color:var(--leaf)">{{ component.body ?: trans('story.body') }}</p>
      <div class="v-story__tags">{% set tags = component.tags|length ? component.tags : [trans('story.tag_1'),trans('story.tag_2'),trans('story.tag_3')] %}{% for tag in tags %}<span class="v-pill">{{ tag.label ?: tag }}</span>{% endfor %}</div>
      <a href="{{ component.button_url ?: link('blog') }}" class="v-btn v-btn--dark v-pill" style="margin-top:26px">{{ component.button_label ?: trans('story.cta') }}</a>
    </div>
  </div>
</section>
