{# velora.editorial_story — empty fields fall back to theme copy and the bundled harvest artwork. #}
{% set button_url = component.button_url ?: link('blog') %}
{% if button_url starts with '/' %}{% set button_url = link(button_url) %}{% endif %}
{% set tags = component.tags|default([])|length ? component.tags : [trans('story.tag_1'), trans('story.tag_2'), trans('story.tag_3')] %}
<section class="v-section" data-component="editorial-story" style="background:var(--mist)">
  <div class="v-wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));align-items:center">
    <div class="v-story__art" style="position:relative;min-height:clamp(300px,40vw,520px);border-radius:220px 40px 40px 220px;overflow:hidden;background:linear-gradient(200deg,var(--sage),var(--leaf) 60%,var(--aubergine))">
      <img src="{{ component.image ?: 'images/velora/story-harvest.svg'|asset }}" alt="{{ component.image_alt ?: trans('story.image_alt') }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
    </div>
    <div class="v-editorial" style="position:relative;z-index:2;margin-inline-start:-70px;padding:40px;background:var(--porcelain);box-shadow:0 50px 80px -60px rgba(38,24,56,.55)">
      <span style="font-family:var(--latin);font-size:13px;font-weight:700;letter-spacing:.12em;color:rgba(38,24,56,.78)">{{ component.kicker ?: trans('story.kicker') }}</span>
      <h2 style="margin-top:16px;font-size:clamp(28px,2.7vw,38px)">{{ component.title ?: trans('story.title') }}</h2>
      <p style="margin-top:18px;font-size:16.5px;line-height:1.9;color:rgba(38,24,56,.78)">{{ component.body ?: trans('story.body') }}</p>
      <div class="v-story__tags">{% for tag in tags %}<span class="v-pill">{{ tag.label ?: tag }}</span>{% endfor %}</div>
      <a href="{{ button_url }}" class="v-btn v-btn--dark v-pill" style="margin-top:26px">{{ component.button_label ?: trans('story.cta') }}</a>
    </div>
  </div>
</section>
