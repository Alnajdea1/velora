{# velora.closing #}
<section class="v-section v-curve-top" style="position:relative;overflow:hidden;background:{{ component.background|default('#261838') }};color:var(--porcelain)">
  <span aria-hidden="true" style="position:absolute;top:-120px;inset-inline-start:20%;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(118,87,232,.45),transparent 70%);animation:v-aura 20s ease-in-out infinite"></span>
  <div class="v-wrap v-ar-title-block" style="position:relative;max-width:900px;text-align:center">
    <h2 style="font-size:clamp(36px,4.4vw,62px);color:var(--porcelain)">{{ component.title|default(trans('newsletter.title')) }}</h2>
    <p style="margin-top:20px;max-width:460px;margin-inline:auto;font-size:14.5px;line-height:1.9;color:rgba(241,236,255,.6)">{{ component.body|default(trans('newsletter.body')) }}</p>
    <salla-newsletter class="v-newsletter" style="margin-top:34px" button-text="{{ component.button_label|default(trans('newsletter.cta')) }}" placeholder="{{ trans('newsletter.placeholder') }}"></salla-newsletter>
  </div>
</section>
