{% set is_ar = ((store.language.code|default('ar'))|slice(0, 2)) == 'ar' %}
<header class="v-header" data-scrolled="false" data-component="header">
  <div class="v-header__bar">
    <div class="v-header__actions">
      <button type="button" class="v-header__language" data-language-switch="{{ is_ar ? 'en' : 'ar' }}" aria-label="{{ is_ar ? 'English' : 'العربية' }}">{{ is_ar ? 'EN' : 'AR' }}</button>
      <salla-cart-summary show-cart-label class="v-header__cart v-btn v-btn--dark v-pill"></salla-cart-summary>

      <a href="{{ link('wishlist') }}" class="v-header__wishlist v-pill" aria-label="{{ trans('common.wishlist') }}">
        <span aria-hidden="true">♥</span>
        <salla-count type="wishlist" class="v-badge--off v-badge"></salla-count>
      </a>

      <button type="button" class="v-header__search v-pill" data-open="search">
        <span aria-hidden="true">⌕</span><span class="v-hide-sm">{{ trans('common.search') }}</span>
      </button>

      <button type="button" class="v-btn v-btn--ghost v-burger" data-open="nav" aria-label="{{ trans('common.menu') }}">☰</button>
    </div>

    <div class="v-header__identity">
      <nav class="v-nav" aria-label="{{ trans('common.menu') }}">
        {% if menus.header|default([])|length %}
          {% for item in menus.header %}
            <a href="{{ item.url }}" class="v-nav__link">{{ item.title }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ link('products') }}" class="v-nav__link">{{ is_ar ? 'الجديد' : 'New' }}</a>
          <a href="{{ link('products') }}" class="v-nav__link">{{ is_ar ? 'العطور' : 'Fragrance' }}</a>
          <a href="{{ link('products') }}" class="v-nav__link">{{ is_ar ? 'العناية' : 'Care' }}</a>
          <a href="{{ link('products') }}" class="v-nav__link">{{ is_ar ? 'الهدايا' : 'Gifts' }}</a>
          <a href="{{ link('blog') }}" class="v-nav__link">{{ is_ar ? 'المجلة' : 'Journal' }}</a>
        {% endif %}
      </nav>

      <a href="{{ link('home') }}" class="v-brand">
        <span class="v-brand__name">{{ store.name }}</span>
        {% if store.logo %}
          <img src="{{ store.logo }}" alt="{{ store.name }}" class="v-brand__logo">
        {% else %}
          <span class="v-brand__mark v-petal" aria-hidden="true"></span>
        {% endif %}
      </a>
    </div>
  </div>
</header>
