{% if component.top_notes or component.top_text or component.heart_notes or component.heart_text or component.base_notes or component.base_text %}
<section class="v-section v-dark v-curve-top" data-component="note-bloom" style="position:relative;overflow:hidden">
  <div class="v-wrap v-ar-title-block" style="max-width:960px;text-align:center">
    <span style="font-family:var(--latin);font-size:11px;font-weight:700;letter-spacing:.22em;color:var(--lilac)">{{ trans('bloom.kicker') }}</span>
    <h2 style="margin-top:14px;font-size:clamp(34px,3.6vw,52px)">{{ trans('bloom.title') }}</h2>
    <div class="v-bloom" style="margin-top:26px">
      {% for i in 0..2 %}<span aria-hidden="true" class="v-bloom__ring" style="width:{{ 250 + i * 90 }}px;height:{{ 250 + i * 90 }}px;background:linear-gradient(150deg,rgba(201,184,255,.5),rgba(118,87,232,.18))"></span>{% endfor %}
      <div class="v-bloom__layers" style="position:relative;z-index:2;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:18px;text-align:start">
        {% for layer in ['top','heart','base'] %}
          {% if component[layer ~ '_notes'] or component[layer ~ '_text'] %}
            <article class="v-card" style="padding:20px;background:rgba(252,251,255,.1);color:var(--porcelain)">
              <h3 style="font-family:var(--display);font-size:22px">{{ trans('bloom.' ~ layer) }}</h3>
              {% if component[layer ~ '_text'] %}<p style="margin-top:9px;color:rgba(241,236,255,.8)">{{ component[layer ~ '_text'] }}</p>{% endif %}
              {% if component[layer ~ '_notes'] %}<div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:12px">{% for note in component[layer ~ '_notes']|split(',') %}<span class="v-pill" style="padding:8px 14px;background:rgba(252,251,255,.14);font-size:12px;font-weight:700">{{ note|trim }}</span>{% endfor %}</div>{% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

