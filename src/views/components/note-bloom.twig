{# velora.note_bloom — product page #}
<section class="v-section v-dark v-curve-top" data-component="note-bloom" style="position:relative;overflow:hidden">
  <div class="v-wrap" style="max-width:960px;text-align:center">
    <span style="font-family:var(--latin);font-size:11px;font-weight:700;letter-spacing:.22em;color:var(--lilac)">{{ trans('bloom.kicker') }}</span>
    <h2 style="margin-top:14px;font-size:clamp(34px,3.6vw,52px)">{{ trans('bloom.title') }}</h2>

    <div role="tablist" style="display:flex;justify-content:center;flex-wrap:wrap;gap:9px;margin-top:30px">
      {% for layer in ['top','heart','base'] %}
        <button type="button" role="tab" class="v-btn v-pill" data-bloom="{{ layer }}"
                aria-selected="{{ layer == 'heart' ? 'true' : 'false' }}">{{ trans('bloom.' ~ layer) }}</button>
      {% endfor %}
    </div>

    <div class="v-bloom" style="margin-top:26px">
      {% for i in 0..2 %}
        <span aria-hidden="true" class="v-bloom__ring" data-bloom-ring="{{ i }}"
              style="width:{{ 250 + i * 90 }}px;height:{{ 250 + i * 90 }}px;background:linear-gradient(150deg,rgba(201,184,255,.5),rgba(118,87,232,.18))"></span>
      {% endfor %}
      {% for layer in ['top','heart','base'] %}
        <div data-bloom-panel="{{ layer }}" {{ layer == 'heart' ? '' : 'hidden' }} style="position:relative;z-index:2;max-width:340px">
          <div style="font-family:var(--display);font-size:26px">{{ trans('bloom.' ~ layer) }}</div>
          <p style="margin-top:10px;font-size:13.5px;line-height:1.85;color:rgba(241,236,255,.75)">{{ component[layer ~ '_text'] }}</p>
          <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:16px">
            {% for note in component[layer ~ '_notes']|split(',') %}
              <span class="v-pill" style="padding:8px 14px;background:rgba(252,251,255,.14);font-size:12px;font-weight:700">{{ note|trim }}</span>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
