{# Approved prototype section: three sculptural seasonal products. #}
<section class="v-section v-showcase v-curve-top" data-component="season-showcase">
  <div class="v-wrap">
    <div class="v-section-heading">
      <h2>{{ component.title ?: trans('showcase.title') }}</h2>
      <p>{{ component.subtitle ?: trans('showcase.subtitle') }}</p>
    </div>
    {% set products = component.products ?: component.category.products %}
    <div class="v-showcase__grid">
      {% for product in products|slice(0, 3) %}
        <div class="v-showcase__item v-showcase__item--{{ loop.index }}">
          <div class="v-showcase__index"><span>0{{ loop.index }}</span><i></i></div>
          {% include 'components.product-card' with { product: product } %}
        </div>
      {% else %}
        {% for i in 1..3 %}
          <div class="v-showcase__item v-showcase__item--{{ i }}" aria-hidden="true">
            <div class="v-showcase__index"><span>0{{ i }}</span><i></i></div>
            <div class="v-product v-product--placeholder"><div class="v-product__media"><span class="v-bottle v-bottle--card"><i></i><b></b><em></em></span></div><div class="v-skeleton" style="height:14px;width:62%"></div><div class="v-skeleton" style="height:12px;width:38%"></div></div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
