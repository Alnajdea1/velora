{# velora.aura_explorer #}
<section id="aura" class="v-section v-curve-top {{ component.light_theme ? '' : 'v-dark' }}" data-component="aura-explorer" style="position:relative;overflow:hidden">
  <span aria-hidden="true" style="position:absolute;top:-10%;inset-inline-start:12%;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(118,87,232,.5),transparent 68%);animation:v-aura 16s ease-in-out infinite"></span>
  <div class="v-wrap" style="position:relative">
    <div class="v-ar-title-block" style="text-align:center;max-width:620px;margin-inline:auto">
      <span style="font-family:var(--latin);font-size:11px;font-weight:700;letter-spacing:.22em;color:var(--lilac)">{{ trans('aura.kicker') }}</span>
      <h2 style="margin-top:16px;font-size:clamp(34px,3.6vw,52px)">{{ component.title|default(trans('aura.title')) }}</h2>
      <p style="margin-top:16px;font-size:14.5px;line-height:1.85;color:rgba(241,236,255,.65)">{{ component.subtitle }}</p>
    </div>

    {% set default_families = [
      {'name':trans('aura.families.floral'),'description':trans('aura.descriptions.floral'),'color_from':'#F1ECFF','color_to':'#C9B8FF'},
      {'name':trans('aura.families.woody'),'description':trans('aura.descriptions.woody'),'color_from':'#BACBB5','color_to':'#71836C'},
      {'name':trans('aura.families.oriental'),'description':trans('aura.descriptions.oriental'),'color_from':'#C9B8FF','color_to':'#7657E8'},
      {'name':trans('aura.families.fresh'),'description':trans('aura.descriptions.fresh'),'color_from':'#DCE6D8','color_to':'#BACBB5'},
      {'name':trans('aura.families.musky'),'description':trans('aura.descriptions.musky'),'color_from':'#FCFBFF','color_to':'#C9B8FF'},
      {'name':trans('aura.families.citrus'),'description':trans('aura.descriptions.citrus'),'color_from':'#FFD9DE','color_to':'#FF7C8B'}
    ] %}
    {% set families = component.families|length ? component.families : default_families %}
    {% set demo_products = [
      {'ar':'عبير البنفسج','en':'Violet Veil','sar':'أو دو بارفان ٥٠ مل','sen':'Eau de parfum 50ml','price':320,'old':395,'rating':'4.9','nar':'برغموت، لافندر، مسك','nen':'Bergamot, Lavender, Musk','t1':'#F1ECFF','t2':'#C9B8FF'},
      {'ar':'ليل اللافندر','en':'Lavender Nocturne','sar':'أو دو بارفان ٧٥ مل','sen':'Eau de parfum 75ml','price':460,'rating':'4.8','nar':'عنبر، بنفسج، فانيلا','nen':'Amber, Violet, Vanilla','t1':'#C9B8FF','t2':'#261838'},
      {'ar':'جذور الميرمية','en':'Sage Roots','sar':'عطر خشبي ٥٠ مل','sen':'Woody parfum 50ml','price':380,'rating':'4.7','nar':'ميرمية، أرز، فيتيفر','nen':'Sage, Cedar, Vetiver','t1':'#DCE6D8','t2':'#71836C'},
      {'ar':'ندى الحقول','en':'Field Dew','sar':'ماء عطري ١٠٠ مل','sen':'Scented water 100ml','price':210,'old':260,'rating':'4.6','nar':'نعناع، ليمون، أوراق خضراء','nen':'Mint, Lemon, Green leaves','t1':'#EAF3FF','t2':'#BACBB5'},
      {'ar':'مسك مخملي','en':'Velvet Musk','sar':'زيت عطري ٣٠ مل','sen':'Perfume oil 30ml','price':265,'rating':'4.9','nar':'مسك، أوركيد، خشب أبيض','nen':'Musk, Orchid, White wood','t1':'#F6EFEA','t2':'#C9B8FF'},
      {'ar':'حمضيات بيضاء','en':'White Citrus','sar':'كولونيا ١٠٠ مل','sen':'Cologne 100ml','price':240,'rating':'4.5','nar':'جريب فروت، نيرولي، مسك','nen':'Grapefruit, Neroli, Musk','t1':'#FFF4EC','t2':'#FF7C8B','soldout':true}
    ] %}
    <div class="v-aura__orbit" style="margin-top:62px" role="tablist">
      {% for family in families %}
        <button type="button" role="tab" class="v-aura__orb" data-aura="{{ loop.index0 }}"
                aria-selected="{{ loop.first ? 'true' : 'false' }}"
                style="background:linear-gradient(150deg,{{ family.color_from }},{{ family.color_to }});transform:translateY({{ (loop.index0 - 2.5)|abs * 30 - 18 }}px)">
          <span style="font-family:var(--display);font-size:17px">{{ family.name }}</span>
        </button>
      {% endfor %}
    </div>

    {% for family in families %}
      {% set family_index = loop.index0 %}
      <div class="v-editorial" data-aura-panel="{{ loop.index0 }}" {{ loop.first ? '' : 'hidden' }}
           style="margin-top:62px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:32px;align-items:center;padding:38px;background:rgba(252,251,255,.06)">
        <div>
          <h3 style="font-size:34px">{{ family.name }}</h3>
          <p style="margin-top:14px;font-size:15px;line-height:1.9;color:rgba(241,236,255,.7);max-width:400px">{{ family.description }}</p>
          <a href="{{ family.category.url ?: link('products') }}" class="v-btn v-pill" style="margin-top:24px;background:var(--porcelain);color:var(--aubergine)">{{ trans('aura.cta') }}</a>
        </div>
        <div class="v-grid v-grid--2 v-aura__products">
          {% for product in family.category.products|slice(0, component.products_shown|default(2)) %}
            {% include 'components.product-card' with { product: product } %}
          {% else %}
            {% for demo in demo_products|slice(family_index, 2) %}{% include 'components.demo-product-card' with { demo: demo } %}{% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>
