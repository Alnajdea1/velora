{# velora.journal #}
<section class="v-section">
  <div class="v-wrap">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px">
      <h2 style="font-size:clamp(34px,3.6vw,52px)">{{ component.title|default(trans('blog.title')) }}</h2>
      <a href="{{ link('blog') }}" style="padding-bottom:4px;border-bottom:1.5px solid var(--lilac);color:var(--aubergine);font-size:13.5px;font-weight:700">{{ trans('blog.all') }}</a>
    </div>
    <div class="v-grid v-grid--3" style="margin-top:40px">
      {% for article in component.articles|slice(0, 3) %}
        <a href="{{ article.url }}">
          <div style="position:relative;overflow:hidden;height:270px;border-radius:{{ loop.index0 == 0 ? '160px 160px 26px 26px' : (loop.index0 == 1 ? '26px 160px 26px 160px' : '26px 26px 160px 160px') }};background:var(--mist)">
            <img src="{{ article.image }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover">
            <span class="v-pill" style="position:absolute;top:14px;inset-inline-start:14px;padding:6px 12px;background:rgba(252,251,255,.92);font-size:11px;font-weight:700;color:var(--iris)">{{ article.category }}</span>
          </div>
          <div style="margin-top:16px;font-family:var(--display);font-size:19px;line-height:1.5;color:var(--aubergine)">{{ article.title }}</div>
          <div style="margin-top:8px;font-size:12.5px;color:var(--leaf)">{{ trans('blog.read_time', { n: article.reading_time }) }}</div>
        </a>
      {% else %}
        {% set demo_articles = [
          {'ar':'كيف تختارين عطراً يهدأ مع بشرتك؟','en':'How to choose a scent that settles with your skin','cat_ar':'دليل العطر','cat_en':'Scent guide','time':5,'c1':'#F1ECFF','c2':'#C9B8FF'},
          {'ar':'طقوس المساء: أربع خطوات بلا استعجال','en':'Evening ritual: four unhurried steps','cat_ar':'العناية','cat_en':'Care','time':4,'c1':'#DCE6D8','c2':'#71836C'},
          {'ar':'من الحقل إلى الزجاجة في يوم واحد','en':'From field to bottle in one day','cat_ar':'حكاياتنا','cat_en':'Stories','time':6,'c1':'#C9B8FF','c2':'#7657E8'}
        ] %}
        {% for article in demo_articles %}
          <a href="{{ link('blog') }}">
            <div class="v-journal-demo v-petal" style="--demo-from:{{ article.c1 }};--demo-to:{{ article.c2 }}"><i></i><b></b><span class="v-pill">{{ store.language.is_rtl ? article.cat_ar : article.cat_en }}</span></div>
            <div style="margin-top:16px;font-family:var(--display);font-size:19px;line-height:1.5;color:var(--aubergine)">{{ store.language.is_rtl ? article.ar : article.en }}</div>
            <div style="margin-top:8px;font-size:12.5px;color:var(--leaf)">{{ trans('blog.read_time', { n: article.time }) }}</div>
          </a>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
