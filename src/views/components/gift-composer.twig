{# velora.gift_composer — without selected products, app.js offers the store's latest products as gift pieces. #}
<section class="v-section v-dark v-curve-top" data-component="gift-composer" {{ component.guaranteed_fallback ? 'data-gift-fallback="true"' : '' }}
         data-max-items="{{ component.max_items|default(3) }}" data-wrap-price="{{ component.wrap_price|default(0) }}"
         data-fallback-url="{{ link('products') }}" data-added-text="{{ trans('cart.added')|e('html_attr') }}"
         style="position:relative;overflow:hidden">
  <div class="v-wrap" style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:54px;align-items:center">
    <div>
      <span style="font-family:var(--latin);font-size:13px;font-weight:700;letter-spacing:.12em;color:var(--coral)">{{ trans('gift.kicker') }}</span>
      <h2 style="margin-top:14px;font-size:clamp(28px,2.7vw,38px)">{{ component.title ?: trans('gift.title') }}</h2>
      <p style="margin-top:16px;max-width:400px;font-size:16px;line-height:1.9;color:rgba(241,236,255,.86)">{{ component.body ?: trans('gift.body') }}</p>

      <div style="margin-top:26px">
        <div style="font-size:13.5px;font-weight:700;color:var(--lilac);margin-bottom:12px">{{ trans('gift.step_shape') }}</div>
        <div style="display:flex;gap:12px">
          {% for shape in ['petal','arch','soft'] %}
            <button type="button" class="v-gift__shape v-gift__shape--{{ shape }}" data-gift-shape="{{ shape }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                    style="width:74px;height:74px;border:0;cursor:pointer;border-radius:{{ shape == 'petal' ? 'var(--petal)' : (shape == 'arch' ? '999px 999px 18px 18px' : '26px') }}"></button>
          {% endfor %}
        </div>
      </div>

      <div style="margin-top:26px">
        <div style="font-size:13.5px;font-weight:700;color:var(--lilac);margin-bottom:12px">{{ trans('gift.step_items') }}</div>
        <div style="display:flex;flex-wrap:wrap;gap:9px" data-gift-items{% if not component.products|default([])|length %} data-gift-source="latest"{% endif %}>
          {% for product in component.products|default([]) %}
            <button type="button" class="v-chip" data-gift-item="{{ product.id }}" data-price="{{ product.price }}" aria-pressed="false">{{ product.name }}</button>
          {% else %}
            {% for i in 1..4 %}<span class="v-chip v-gift__skeleton" aria-hidden="true"></span>{% endfor %}
          {% endfor %}
        </div>
        <p class="v-empty" data-gift-empty hidden>{{ trans('common.configure_products') }}</p>
      </div>
    </div>

    <div class="v-editorial" style="padding:30px;background:rgba(252,251,255,.07)">
      <div class="v-gift__box v-gift__box--art" data-gift-box data-shape="petal" style="border-radius:var(--petal);background:linear-gradient(165deg,var(--lilac),var(--iris))">
        <img class="v-gift__art" src="{{ component.image ?: 'images/velora/gift-box.svg'|asset }}" alt="" loading="lazy">
        <div data-gift-chosen style="position:absolute;bottom:16px;inset-inline:16px;display:flex;flex-direction:column;gap:6px"></div>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:22px">
        <div>
          <div style="font-size:13px;color:var(--lilac)">{{ trans('gift.total') }}</div>
          <div class="num" data-gift-total style="font-size:24px">—</div>
        </div>
        <button type="button" class="v-btn v-btn--coral" data-gift-add disabled>{{ trans('gift.cta') }}</button>
      </div>
    </div>
  </div>
</section>
