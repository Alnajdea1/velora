{# Store details, the footer menu, contacts, apps and payment methods come from Salla components and the store's own data. #}
<footer class="v-footer" data-testid="store-footer">
  <div class="v-wrap v-footer__grid">
    <div class="v-footer__brand">
      <a href="{{ link('/') }}" class="v-footer__name">
        <span class="v-petal v-footer__mark" aria-hidden="true"></span>{{ store.name }}
      </a>
      {% if store.description %}<p class="v-footer__about">{{ store.description|striptags }}</p>{% endif %}
      <salla-social class="v-footer__social"></salla-social>
    </div>
    <div>
      <h2 class="v-footer__title">{{ trans('footer.links') }}</h2>
      <salla-menu class="v-footer__menu" source="footer" with-cookie-preferences></salla-menu>
    </div>
    <salla-contacts class="v-footer__contacts"></salla-contacts>
    <salla-apps-icons class="v-footer__apps"></salla-apps-icons>
  </div>
  <div class="v-wrap v-footer__bottom">
    <span>© {{ "now"|date("Y") }} {{ store.name }}</span>
    <salla-payments class="v-footer__payments"></salla-payments>
  </div>

  <div class="store-trust-badges" style="display:flex;justify-content:center;padding:16px 0">
    <salla-trust-badges></salla-trust-badges>
  </div>
</footer>
