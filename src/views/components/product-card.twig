{# @param product #}
<article class="v-product" data-product-id="{{ product.id }}" data-product-state="{{ product.is_available ? (product.is_on_sale ? 'sale' : 'regular') : 'sold-out' }}">
  <div class="v-product__media">
    {% if product.image.url %}
      <img src="{{ product.image.url }}" alt="{{ product.name }}" loading="lazy" width="640" height="800">
    {% else %}
      <span class="v-bottle v-bottle--card" aria-hidden="true"><i></i><b></b><em></em></span>
    {% endif %}
    {% if product.images[1] %}<img src="{{ product.images[1].url }}" alt="" loading="lazy" aria-hidden="true">{% endif %}

    <div class="v-product__badges">
      {% if product.promotion_title %}<span class="v-badge">{{ product.promotion_title }}</span>{% endif %}
      {% if not product.is_available %}<span class="v-badge v-badge--soldout">{{ trans('product.sold_out') }}</span>{% endif %}
      {% if product.can_show_remained_quantity and product.quantity <= 5 and product.is_available %}<span class="v-badge v-badge--low">{{ trans('product.low_stock', { n: product.quantity }) }}</span>{% endif %}
    </div>

    <salla-button shape="icon" fill="none" class="v-pill v-product__wish" onclick="salla.wishlist.toggle({{ product.id }})"
                  aria-label="{{ trans('common.wishlist') }}">♥</salla-button>

    <div class="v-product__quickadd">
      <salla-add-product-button product-id="{{ product.id }}" class="v-btn v-btn--primary" style="width:100%">
        {{ product.is_available ? trans('product.quick_add') : trans('product.notify') }}
      </salla-add-product-button>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:7px;padding-inline:4px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px">
      <span style="font-family:var(--latin);font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--leaf)">{{ product.brand.name ?: product.category.name }}</span>
      {% if product.rating.stars %}<span style="font-size:11px;font-weight:700;color:var(--iris);white-space:nowrap">★ {{ product.rating.stars|localize_number }}</span>{% endif %}
    </div>
    <h3 style="font-size:19px"><a href="{{ product.url }}" style="color:var(--aubergine)">{{ product.name }}</a></h3>
    <p style="margin:0;font-size:12.5px;line-height:1.6;color:var(--leaf)">{{ product.subtitle }}</p>

    <div class="v-product__price">
      <span class="num" style="font-size:19px">{{ product.price|money }}</span>
      {% if product.is_on_sale %}
        <span class="v-product__old">{{ product.regular_price|money }}</span>
        {% if product.discount_percentage %}<span class="v-badge v-badge--off">−{{ product.discount_percentage }}</span>{% endif %}
      {% endif %}
    </div>

    {% if product.options|length %}
      <div class="v-product__swatches" aria-label="{{ trans('product.variants') }}">
        {% for option in product.options|slice(0, 5) %}
          <span title="{{ option.name ?: option.value }}" style="--swatch:{{ option.color ?: '#C9B8FF' }}">{{ option.display_value ?: '' }}</span>
        {% endfor %}
        {% if product.options|length > 5 %}<small>+{{ product.options|length - 5 }}</small>{% endif %}
      </div>
    {% endif %}

    {% if product.metadata.fragrance_notes %}
      <div style="margin-top:4px;border-top:1px solid var(--mist);padding-top:9px">
        <button type="button" data-toggle-notes aria-expanded="false"
                style="display:flex;align-items:center;gap:7px;background:none;border:0;padding:0;cursor:pointer;font-size:12px;font-weight:700;color:var(--iris)">
          {{ trans('product.notes') }}
        </button>
        <div class="v-product__notes" data-open="false">
          <div style="display:flex;flex-wrap:wrap;gap:6px;padding-top:9px">
            {% for note in product.metadata.fragrance_notes|split(',') %}
              <span class="v-pill" style="padding:5px 11px;background:var(--mist);font-size:11.5px">{{ note|trim }}</span>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</article>
