{#
  Salla store features (feature: component-store-features).
  | items[]       | array  | features configured in the editor (icon, title, text) |
  Without items, three neutral service notes from the theme locales are shown.
#}
{% set features = items|default([])|length ? items : [
  {'art': 'delivery', 'title': trans('features.delivery_title'), 'text': trans('features.delivery_text')},
  {'art': 'payment', 'title': trans('features.payment_title'), 'text': trans('features.payment_text')},
  {'art': 'support', 'title': trans('features.support_title'), 'text': trans('features.support_text')}
] %}
<section {% if componentId is defined %}component-id="{{ componentId }}" {% endif %}class="v-features" data-component="store-features">
  <div class="v-wrap">
    <ul class="v-features__list">
      {% for item in features %}
        <li class="v-features__item">
          <span class="v-features__icon v-petal" aria-hidden="true">
            {% if item.icon %}
              <i class="{{ item.icon }}"></i>
            {% elseif item.art == 'payment' %}
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
            {% elseif item.art == 'support' %}
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18l-1 3 4-2h8a4 4 0 0 0 4-4V9a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v6c0 1.1.4 2.1 1 3z"/><path d="M9 11h.01M12 11h.01M15 11h.01"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4-9 4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></svg>
            {% endif %}
          </span>
          <div>
            <h3>{{ item.title }}</h3>
            {% if item.text %}<p>{{ item.text }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
