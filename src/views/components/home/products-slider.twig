{#
  Salla products slider (feature: component-products-slider).
  | products.source       | string  | products source chosen in the editor, defaults to latest |
  | products.source_value | ?array  | ids for the chosen source                                |
  | title                 | string  | section title                                            |
  | display_all_url       | ?string | "view all" link                                          |
  | limit                 | int     | number of products                                       |
#}
{% set slider_source = products.source|default('latest') %}
{% set slider_value = products.source_value|default([]) %}
{% set all_url = display_all_url|default('') ?: link('products') %}
<section {% if componentId is defined %}component-id="{{ componentId }}" {% endif %}class="v-section v-slider" data-component="products-slider">
  <div class="v-wrap">
    <div class="v-section-heading">
      <div>
        <span class="v-slider__kicker">{{ trans('slider.kicker') }}</span>
        <h2>{{ title|default('') ?: trans('slider.title') }}</h2>
      </div>
      <a href="{{ all_url }}" class="v-slider__all">{{ trans('slider.all') }}</a>
    </div>
    <salla-products-slider class="v-slider__track" product-card-component="custom-salla-product-card"
                           source="{{ slider_source }}"{% if slider_value|length %} source-value="{{ slider_value|json_encode }}"{% endif %}
                           limit="{{ limit|default(8) }}" block-title=" " slider-id="velora-products-slider-{{ position|default(0) }}"></salla-products-slider>
  </div>
</section>
