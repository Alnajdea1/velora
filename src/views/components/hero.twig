{# Velora — Lavender in Motion hero. Empty fields fall back to theme copy and the bundled hero artwork. #}
{% set primary_url = component.primary_url ?: link('products') %}
{% if primary_url starts with '/' %}{% set primary_url = link(primary_url) %}{% endif %}
{% set secondary_url = component.secondary_url ?: '#aura' %}
{% if secondary_url starts with '/' %}{% set secondary_url = link(secondary_url) %}{% endif %}
{% set pick_url = component.product_url ?: link('products') %}
{% if pick_url starts with '/' %}{% set pick_url = link(pick_url) %}{% endif %}
{% set image_alt = component.image_alt ?: trans('hero.art_alt') %}
{% if component.stat_1_value or component.stat_2_value or component.stat_3_value %}
  {% set stats = [
    {'value': component.stat_1_value, 'label': component.stat_1_label},
    {'value': component.stat_2_value, 'label': component.stat_2_label},
    {'value': component.stat_3_value, 'label': component.stat_3_label}
  ] %}
{% else %}
  {% set stats = [
    {'value': trans('hero.stat_1_value'), 'label': trans('hero.stat_1_label')},
    {'value': trans('hero.stat_2_value'), 'label': trans('hero.stat_2_label')},
    {'value': trans('hero.stat_3_value'), 'label': trans('hero.stat_3_label')}
  ] %}
{% endif %}
{% set notes = component.notes|default([])|length ? component.notes : [
  {'tag': trans('hero.note_1_tag'), 'label': trans('hero.note_1_label')},
  {'tag': trans('hero.note_2_tag'), 'label': trans('hero.note_2_label')},
  {'tag': trans('hero.note_3_tag'), 'label': trans('hero.note_3_label')}
] %}
<section class="v-hero" data-component="lavender-hero">
  <div class="v-wrap v-hero__grid">
    <div class="v-hero__copy">
      <span class="v-pill v-hero__kicker">
        <i aria-hidden="true"></i>{{ component.kicker ?: trans('hero.kicker') }}
      </span>
      <h1 class="v-hero__title">{{ component.line_1 ?: trans('hero.line_1') }} <span>{{ component.line_2 ?: trans('hero.line_2') }}</span> <em>{{ component.line_3 ?: trans('hero.line_3') }}</em></h1>
      <p class="v-hero__body">{{ component.body ?: trans('hero.body') }}</p>
      <div class="v-hero__actions">
        <a href="{{ primary_url }}" class="v-btn v-btn--primary v-pill">
          {{ component.primary_label ?: trans('hero.cta') }} <span class="v-flip" aria-hidden="true">←</span>
        </a>
        <a href="{{ secondary_url }}" class="v-hero__secondary">{{ component.secondary_label ?: trans('hero.cta_secondary') }}</a>
      </div>
      <dl class="v-hero__stats">
        {% for stat in stats %}
          {% if stat.value and stat.label %}<div><dt>{{ stat.value }}</dt><dd>{{ stat.label }}</dd></div>{% endif %}
        {% endfor %}
      </dl>
    </div>

    {# Without a merchant image, app.js shows the store's newest product here instead of the bundled artwork. #}
    <div class="v-hero__art" data-hero-motion aria-label="{{ image_alt }}"{% if not component.image %} data-hero-product{% endif %}>
      <div class="v-hero__arch">
        <span class="v-hero__glow" aria-hidden="true"></span>
        <img src="{{ component.image ?: 'images/velora/hero-bottle.svg'|asset }}" alt="{{ image_alt }}" fetchpriority="high"{% if not component.image %} class="v-hero__artwork"{% endif %}>
        <div class="v-hero__pick"{% if not component.product_name and not component.product_url %} data-pick-auto{% endif %}>
          <span><small>{{ trans('hero.editor_pick') }}</small><strong>{{ component.product_name ?: trans('hero.pick_name') }}</strong></span>
          <a href="{{ pick_url }}" class="v-btn v-btn--dark v-pill">{{ trans('common.discover') }}</a>
        </div>
      </div>
      {% for note in notes|slice(0, 3) %}
        <span class="v-pill v-hero__note v-hero__note--{{ loop.index }}"><b>{{ note.tag }}</b> {{ note.label }}</span>
      {% endfor %}
    </div>
  </div>
</section>
