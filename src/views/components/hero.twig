{# velora.hero #}
<section class="v-section" style="position:relative;overflow:hidden">
  <span aria-hidden="true" style="position:absolute;top:-160px;inset-inline-end:-120px;width:620px;height:620px;border-radius:50%;background:radial-gradient(circle at 40% 40%,var(--mist),rgba(201,184,255,.55) 45%,transparent 72%)"></span>
  <div class="v-wrap" style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:56px;align-items:center">
    <div style="animation:v-rise .9s ease both">
      <span class="v-pill" style="display:inline-flex;align-items:center;gap:9px;padding:7px 15px;background:var(--porcelain);box-shadow:0 10px 30px -22px rgba(38,24,56,.6);font-size:12px;color:var(--leaf);font-weight:700">
        <span style="width:7px;height:7px;border-radius:999px;background:var(--coral)"></span>{{ component.kicker|default(trans('hero.kicker')) }}
      </span>
      <h1 style="margin-top:22px;font-size:clamp(46px,6.2vw,86px);line-height:1.42">
        {{ component.line_1 }}<br>
        <span style="color:var(--iris)">{{ component.line_2 }}</span><br>
        {{ component.line_3 }}
      </h1>
      <p style="margin-top:24px;max-width:430px;font-size:15.5px;line-height:1.85;color:var(--leaf)">{{ component.body }}</p>
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:34px">
        <a href="{{ component.primary_url|default(link('products')) }}" class="v-btn v-btn--primary v-pill">{{ component.primary_label|default(trans('hero.cta')) }}</a>
        <a href="{{ component.secondary_url|default('#aura') }}" style="padding-bottom:4px;border-bottom:1.5px solid var(--lilac);color:var(--aubergine);font-size:14px;font-weight:700">{{ component.secondary_label|default(trans('hero.cta_secondary')) }}</a>
      </div>
    </div>

    <div style="position:relative;min-height:clamp(430px,52vw,580px)">
      <div class="v-arch" style="position:absolute;inset-inline-start:0;top:0;width:80%;height:100%;background:linear-gradient(170deg,var(--mist),var(--lilac) 48%,var(--iris))">
        {% if component.image %}<img src="{{ component.image }}" alt="" style="width:100%;height:100%;object-fit:cover">{% endif %}
      </div>
      <span aria-hidden="true" class="v-petal" style="position:absolute;inset-inline-end:0;top:12%;width:148px;height:148px;background:linear-gradient(140deg,var(--sage),var(--leaf));animation:v-drift 13s ease-in-out infinite"></span>
      {% for note in component.notes %}
        <div class="v-pill" style="position:absolute;{{ loop.index0 == 0 ? 'top:6%;inset-inline-end:-2%' : (loop.index0 == 1 ? 'top:44%;inset-inline-start:-6%' : 'bottom:22%;inset-inline-end:-4%') }};padding:9px 15px;background:rgba(252,251,255,.94);backdrop-filter:blur(8px);box-shadow:0 16px 34px -22px rgba(38,24,56,.6);font-size:12px;font-weight:700;white-space:nowrap;animation:v-drift {{ 9 + loop.index0 * 2 }}s ease-in-out infinite">
          <span style="font-family:var(--latin);font-size:10px;letter-spacing:.14em;color:var(--iris)">{{ note.tag }}</span> {{ note.label }}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
