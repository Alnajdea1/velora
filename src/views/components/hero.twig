{# Velora — Lavender in Motion hero. The CSS bottle is the approved prototype artwork fallback. #}
<section class="v-hero" data-component="lavender-hero">
  <span class="v-hero__wash v-hero__wash--iris" aria-hidden="true"></span>
  <span class="v-hero__wash v-hero__wash--sage" aria-hidden="true"></span>

  <div class="v-wrap v-hero__grid">
    <div class="v-hero__copy">
      <span class="v-pill v-hero__kicker">
        <i aria-hidden="true"></i>{{ component.kicker ?: trans('hero.kicker') }}
      </span>
      <h1 class="v-hero__title">
        {{ component.line_1 ?: trans('hero.line_1') }}<br>
        <span>{{ component.line_2 ?: trans('hero.line_2') }}</span><br>
        <em>{{ component.line_3 ?: trans('hero.line_3') }}</em>
      </h1>
      <p class="v-hero__body">{{ component.body ?: trans('hero.body') }}</p>
      <div class="v-hero__actions">
        <a href="{{ component.primary_url ?: link('products') }}" class="v-btn v-btn--primary v-pill">
          {{ component.primary_label ?: trans('hero.cta') }} <span class="v-flip" aria-hidden="true">←</span>
        </a>
        <a href="{{ component.secondary_url ?: '#aura' }}" class="v-hero__secondary">{{ component.secondary_label ?: trans('hero.cta_secondary') }}</a>
      </div>
      <dl class="v-hero__stats">
        <div><dt>{{ component.stat_1_value ?: trans('hero.stat_1_value') }}</dt><dd>{{ component.stat_1_label ?: trans('hero.stat_1_label') }}</dd></div>
        <div><dt>{{ component.stat_2_value ?: trans('hero.stat_2_value') }}</dt><dd>{{ component.stat_2_label ?: trans('hero.stat_2_label') }}</dd></div>
        <div><dt>{{ component.stat_3_value ?: trans('hero.stat_3_value') }}</dt><dd>{{ component.stat_3_label ?: trans('hero.stat_3_label') }}</dd></div>
      </dl>
    </div>

    <div class="v-hero__art" aria-label="{{ component.image_alt ?: trans('hero.art_alt') }}">
      <div class="v-hero__arch">
        <span class="v-hero__glow" aria-hidden="true"></span>
        {% if component.image %}
          <img src="{{ component.image }}" alt="{{ component.image_alt ?: trans('hero.art_alt') }}" fetchpriority="high">
        {% else %}
          <span class="v-bottle v-bottle--hero" aria-hidden="true"><i></i><b></b><em></em></span>
        {% endif %}
        <div class="v-hero__pick">
          <span><small>{{ trans('hero.editor_pick') }}</small><strong>{{ component.product_name ?: trans('hero.product_name') }}</strong></span>
          <a href="{{ component.product_url ?: link('products') }}" class="v-btn v-btn--dark v-pill">{{ trans('common.discover') }}</a>
        </div>
      </div>
      <span class="v-hero__leaf v-petal" aria-hidden="true"></span>
      {% set default_notes = [
        {'tag':'TOP','label':trans('hero.note_top')},
        {'tag':'HEART','label':trans('hero.note_heart')},
        {'tag':'BASE','label':trans('hero.note_base')}
      ] %}
      {% set hero_notes = component.notes|length ? component.notes : default_notes %}
      {% for note in hero_notes|slice(0, 3) %}
        <span class="v-pill v-hero__note v-hero__note--{{ loop.index }}"><b>{{ note.tag }}</b> {{ note.label }}</span>
      {% endfor %}
    </div>
  </div>
</section>
