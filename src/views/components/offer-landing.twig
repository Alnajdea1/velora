{% if component.badge and component.title_line_1 and component.title_line_2 and component.body %}
<section class="v-offer" data-component="offer-landing">
  <span class="v-offer__aura" aria-hidden="true"></span>
  <div class="v-wrap v-offer__grid">
    <div class="v-offer__copy">
      <span class="v-offer__badge">{{ component.badge }}</span>
      <h2 class="v-offer__title"><span>{{ component.title_line_1 }}</span><span>{{ component.title_line_2 }}</span></h2>
      <p class="v-offer__body">{{ component.body }}</p>
      {% if component.cta_label %}<a href="{{ component.cta_url ?: link('products') }}" class="v-btn v-btn--light v-pill v-offer__cta">{{ component.cta_label }}</a>{% endif %}
    </div>
    {% if component.tiles|length %}
      <div class="v-offer__tiles" aria-label="{{ trans('offer.categories_label') }}">
        {% for tile in component.tiles|slice(0, 4) %}<a href="{{ tile.url ?: link('products') }}" class="v-offer__tile v-offer__tile--{{ loop.index }}"><span>{{ tile.label }}</span></a>{% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% endif %}

