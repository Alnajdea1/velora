<!DOCTYPE html>
<html lang="{{ store.language.code|default('ar') }}" dir="{{ store.language.is_rtl ? 'rtl' : 'ltr' }}"
      data-reduce-motion="{{ theme.settings.get('reduce_motion', false) ? 'true' : 'false' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}{{ page.title|striptags }}{% endblock %}{% if page.title %} — {% endif %}{{ store.name }}</title>
  {% hook 'head:start' %}
  <link rel="stylesheet" href="{{ 'styles/app.css'|asset }}">
  <style>
    :root{
      --iris:{{ theme.settings.get('accent', '#7657E8') }};
      --aubergine:{{ theme.settings.get('dark', '#261838') }};
      --coral:{{ theme.settings.get('micro_accent', '#FF7C8B') }};
    }
  </style>
  {% block styles %}{% endblock %}
  {% hook 'head:end' %}
</head>
<body class="v-body">
  {% hook 'body:start' %}
  {% include 'components.announcement' %}
  {% include 'components.header' %}

  <main id="main">{% block content %}{% endblock %}</main>

  {% include 'components.footer' %}
  {% include 'components.search-overlay' %}
  {% include 'components.mobile-nav' %}

  <script src="{{ 'js/app.js'|asset }}" defer></script>
  {% block scripts %}{% endblock %}
  {% hook 'body:end' %}
</body>
</html>
