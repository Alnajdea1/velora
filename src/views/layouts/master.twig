<!DOCTYPE html>
{% set current_locale = store.language.code|default('ar') %}
{% set is_arabic = (current_locale|slice(0, 2)) == 'ar' %}
<html lang="{{ current_locale }}" dir="{{ (store.language.is_rtl or is_arabic) ? 'rtl' : 'ltr' }}"
      data-reduce-motion="{{ theme.settings.get('reduce_motion', false) ? 'true' : 'false' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}{{ page.title|striptags }}{% endblock %}{% if page.title %} — {% endif %}{{ store.name }}</title>
  {% hook 'head:start' %}
  <link rel="stylesheet" href="{{ 'app.css'|asset }}">
  <link rel="stylesheet" href="{{ 'add-product-toast.css'|asset }}">
  <style>
    :root{
      --porcelain:{{ theme.settings.get('porcelain', '#FCFBFF') }};
      --mist:{{ theme.settings.get('mist', '#F1ECFF') }};
      --lilac:{{ theme.settings.get('lilac', '#C9B8FF') }};
      --iris:{{ theme.settings.get('accent', '#7657E8') }};
      --aubergine:{{ theme.settings.get('dark', '#261838') }};
      --sage:{{ theme.settings.get('sage', '#BACBB5') }};
      --leaf:{{ theme.settings.get('leaf', '#71836C') }};
      --coral:{{ theme.settings.get('micro_accent', '#FF7C8B') }};
      --r-card:{{ theme.settings.get('card_radius', 28) }}px;
      --r-editorial:{{ theme.settings.get('editorial_radius', 44) }}px;
    }
  </style>
  {% block styles %}{% endblock %}
  {% hook 'head' %}
  {% hook 'head:end' %}
</head>
<body class="v-body">
  {% hook 'body:start' %}
  {% include 'components.announcement' %}
  {% include 'header' %}

  <main id="main">{% block content %}{% endblock %}</main>

  {% if theme.settings.get('newsletter_enabled', true) %}{% include 'components.closing' with { component: {} } %}{% endif %}
  {% include 'components.footer' %}
  {% include 'components.search-overlay' %}
  {% include 'components.mobile-nav' %}
  {% if theme.settings.get('reviewer_panel', false) %}{% include 'components.reviewer-panel' %}{% endif %}

  <script src="{{ 'i18n.js'|asset }}" defer></script>
  <script src="{{ 'app.js'|asset }}" defer></script>
  {% if theme.settings.get('enable_add_product_toast', true) %}
    <script src="{{ 'add-product-toast.js'|asset }}" defer></script>
  {% endif %}
  {% block scripts %}{% endblock %}
  {% hook 'body' %}
  {% hook 'body:end' %}

  {% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
  {% endif %}
  <salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
  <salla-search data-testid="store-search-modal"></salla-search>
  <salla-login-modal data-testid="store-login-modal"></salla-login-modal>
  {% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
  {% endif %}
</body>
</html>
