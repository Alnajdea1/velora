{# velora.routine_path #}
<section class="v-section" data-component="routine-path" style="overflow:hidden">
  <div class="v-wrap">
    <div style="text-align:center;max-width:560px;margin-inline:auto">
      <span style="font-family:var(--latin);font-size:11px;font-weight:700;letter-spacing:.22em;color:var(--iris)">{{ trans('routine.kicker') }}</span>
      <h2 style="margin-top:14px;font-size:clamp(34px,3.6vw,52px)">{{ component.title|default(trans('routine.title')) }}</h2>
    </div>
    <ol class="v-path" style="margin-top:54px;padding:0;list-style:none">
      <span aria-hidden="true" class="v-path__arc"></span>
      {% for step in component.steps %}
        <li class="v-path__step" data-step="{{ loop.index0 }}"
            style="display:flex;flex-direction:column;gap:14px;align-items:flex-start">
          <button type="button" class="v-path__node" aria-current="{{ loop.first ? 'true' : 'false' }}"
                  style="background:linear-gradient(150deg,var(--mist),#DCE6D8)">
            <span class="num" style="font-size:15px">{{ loop.index }}</span>
          </button>
          <div class="v-card" style="padding:14px 18px;border-radius:22px;max-width:230px;box-shadow:inset 0 0 0 1px var(--mist)">
            <div style="font-family:var(--display);font-size:17px">{{ step.title }}</div>
            <p style="margin-top:5px;font-size:12.5px;line-height:1.7;color:var(--leaf)">{{ step.body }}</p>
            {% if step.product %}
              <salla-add-product-button product-id="{{ step.product.id }}" class="v-btn v-btn--ghost" style="margin-top:10px">{{ trans('product.quick_add') }}</salla-add-product-button>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
    <div style="display:flex;justify-content:center;margin-top:10px">
      <a href="{{ component.cta_url|default(link('products')) }}" class="v-btn v-btn--primary v-pill">{{ component.cta_label|default(trans('routine.cta')) }}</a>
    </div>
  </div>
</section>
