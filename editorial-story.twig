{# velora.editorial_story #}
<section class="v-section" data-component="editorial-story" style="background:var(--mist)">
  <div class="v-wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));align-items:center">
    <div style="position:relative;min-height:clamp(300px,40vw,520px);border-radius:220px 40px 40px 220px;overflow:hidden;background:linear-gradient(200deg,var(--sage),var(--leaf) 60%,var(--aubergine))">
      {% if component.image %}<img src="{{ component.image }}" alt="" style="width:100%;height:100%;object-fit:cover">{% endif %}
    </div>
    <div class="v-editorial" style="position:relative;z-index:2;margin-inline-start:-70px;padding:40px;background:var(--porcelain);box-shadow:0 50px 80px -60px rgba(38,24,56,.55)">
      <span style="font-family:var(--latin);font-size:11px;font-weight:700;letter-spacing:.22em;color:var(--leaf)">{{ component.kicker }}</span>
      <h2 style="margin-top:16px;font-size:clamp(34px,3.6vw,52px)">{{ component.title }}</h2>
      <p style="margin-top:18px;font-size:15px;line-height:1.9;color:var(--leaf)">{{ component.body }}</p>
      {% if component.button_url %}<a href="{{ component.button_url }}" class="v-btn v-btn--dark v-pill" style="margin-top:26px">{{ component.button_label|default(trans('common.discover')) }}</a>{% endif %}
    </div>
  </div>
</section>
