{% extends 'layouts.master' %}
{% block title %}{{ page.title|default(trans('blog.title')) }}{% endblock %}
{% block content %}
  <section class="v-page-hero v-curve-bottom"><div class="v-wrap"><salla-breadcrumb></salla-breadcrumb><h1>{{ page.title|default(trans('blog.title')) }}</h1><p>{{ page.description }}</p></div></section>
  <section class="v-section"><div class="v-wrap"><div class="v-grid v-grid--3">
    {% for article in articles %}
      <article class="v-article-card"><a href="{{ article.url }}" class="v-article-card__image"><img src="{{ article.image }}" alt="{{ article.title }}" loading="lazy"></a><div><small>{{ article.category.name }}</small><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.summary }}</p><span>{{ trans('blog.read_time', {n:article.reading_time}) }}</span></div></article>
    {% else %}<div class="v-empty"><h2>{{ trans('blog.empty') }}</h2></div>{% endfor %}
  </div><salla-pagination></salla-pagination></div></section>
{% endblock %}

